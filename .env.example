# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/course_portal
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/course_portal?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/course_portal

# JSON Web Token Secret & Expiration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
